# ── { OUTTAKE } backend configuration ────────────────────────────────────────
# Copy to .env (never commit) or set in your hosting provider's env vars.
# All variables are optional locally — local dev runs on SQLite with no setup.

# PostgreSQL connection string for production. Use Neon/Supabase free tier.
# Leave unset for local dev (falls back to SQLite file at data/vault.db).
DATABASE_URL=postgresql://user:password@host/dbname
# Set to "require" when your host needs an SSL connection (Neon usually does).
PGSSL=require

# Secret for admin endpoints (/api/refresh, /api/save). Pass as
# `Authorization: Bearer <ADMIN_KEY>`. Leave unset locally to skip auth checks
# on the dev server.
ADMIN_KEY=change-me

# YouTube Data API v3 key (optional). When set, /api/refresh uses the official
# API (authoritative status + duration). When unset it falls back to the
# keyless youtube.com/oembed probe (still fully functional).
YOUTUBE_API_KEY=

# Local server only.
PORT=8080
DB_PATH=data/vault.db

# ── Admin content additions (self-serve "paste a link, queue it") ──────────
# Open /admin.html, paste a YouTube URL, verify, and queue it. Queue entries
# live in the pending_tracks DB table. The apply workflow
# (.github/workflows/apply_pending.yml) fetches them, runs scripts/add_tracks.js
# (verify → vault_roster.json + harvested.json), rebuilds, commits, and pushes —
# which redeploys to Vercel. The workflow needs these GitHub Action secrets:
#   PROD_URL   -> https://your-app.vercel.app
#   ADMIN_KEY  -> the value of ADMIN_KEY below